{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sleep-education-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION_STATE",
        "class_name": "ConversationStateCoordinator"
      }
    ]
  },
  "exports": {
    "ConversationStateCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "EVIDENCE_BANK_ENABLED": "false",
    "EVIDENCE_BANK_VERSION": "",
    "ALLOWED_ORIGINS": "http://localhost:8084,http://127.0.0.1:8084"
  }
}
